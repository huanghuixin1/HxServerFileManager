<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 桌面壳不弹控制台窗口（Windows） -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Photino.NET：跨平台轻量 WebView（Windows=WebView2 / macOS=WKWebView / Linux=WebKitGTK） -->
    <PackageReference Include="Photino.NET" Version="3.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用主项目，复用 Web 服务构建逻辑 -->
    <ProjectReference Include="..\HxServerFileManager\HxServerFileManager.csproj" />
  </ItemGroup>

  <!--
    主项目的 CopyWwwrootToOutput Target 不会在引用方构建时执行，
    这里从主项目源目录把 wwwroot 镜像到桌面壳输出目录（先清后拷，同主项目逻辑）。
  -->
  <Target Name="CopyWwwrootToDesktopOutput" AfterTargets="Build">
    <ItemGroup>
      <WwwrootSource Include="$(MSBuildThisFileDirectory)..\HxServerFileManager\wwwroot\**\*" />
      <WwwrootStale Include="$(OutDir)wwwroot\**\*" />
    </ItemGroup>
    <Delete Files="@(WwwrootStale)" ContinueOnError="true" />
    <Copy SourceFiles="@(WwwrootSource)"
          DestinationFiles="@(WwwrootSource->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high"
             Text="wwwroot -&gt; $(OutDir)wwwroot：已复制 @(WwwrootSource->Count()) 个文件" />
  </Target>

</Project>
