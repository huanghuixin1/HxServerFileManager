<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 应用版本：启动时打印、/api/health 返回；桌面壳标题同步显示（见 WebHost.AppVersion） -->
    <Version>1.1.0</Version>
    <!-- 被 Desktop 项目引用时，不要继承 RID 导致 self-contained 冲突（NETSDK1151） -->
    <SelfContained>false</SelfContained>
    <!-- 应用图标：仓库根目录 logo.ico（嵌入 exe，Windows 资源管理器/任务栏显示） -->
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <!-- 不产出独立 .pdb 文件：调试符号内嵌进程序集（产物目录干净，同时保留调试能力） -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- 保持控制台(Exe)，通过框架引用启用 Kestrel / ASP.NET Core 能力 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- 登录鉴权库：HxSimpleWebAuth（凭据 + token + 失败锁定 + 本机回环绑定） -->
    <Reference Include="HxSimpleWebAuth">
      <HintPath>libs\HxSimpleWebAuth.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 鉴权库随编译输出 -->
  <ItemGroup>
    <None Include="libs\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 源 Data 目录任何文件都不随构建拷贝（Data 由运行时在 ContentRoot 下按需生成） -->
  <ItemGroup>
    <None Remove="Data\**\*" />
  </ItemGroup>

  <!--
    编译后把 wwwroot 整体镜像到输出目录。
    先清空目标目录再拷贝：Vite 每次构建产出的资源文件名带内容哈希，
    单纯增量复制会让旧的 index-xxxx.js / .css 无限堆积。
  -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build">
    <ItemGroup>
      <WwwrootSource Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
      <WwwrootStale Include="$(OutDir)wwwroot\**\*" />
    </ItemGroup>
    <Delete Files="@(WwwrootStale)" ContinueOnError="true" />
    <Copy SourceFiles="@(WwwrootSource)"
          DestinationFiles="@(WwwrootSource->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high"
             Text="wwwroot -&gt; $(OutDir)wwwroot：已复制 @(WwwrootSource->Count()) 个文件" />
  </Target>
  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="configs\env.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    构建/发布输出清理：Data 目录是运行时在 ContentRoot 下按需生成的（连接/密钥/设置），
    不应随构建产物分发 —— 构建和发布后把输出目录里的 Data 内容清掉（含历史遗留文件）。
    首次运行时应用会自行重建空的 Data。
    Debug 构建跳过：调试时直接跑 bin/Debug 里的 exe，Data 作为本地调试数据保留（否则每次
    调试都要重新添加连接）；Release 构建与所有 publish 仍清理（发布产物绝不带 Data）。
    注意不能靠 $(PublishDir) 判空区分 build/publish —— 普通 build 时它也有默认值
    （bin\...\publish\），所以拆成两个 target：Build 钩子带条件，Publish 钩子无条件。
  -->
  <Target Name="CleanOutputData" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <OutputData Include="$(OutDir)Data\**\*" />
    </ItemGroup>
    <Delete Files="@(OutputData)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)Data" ContinueOnError="true" />
  </Target>
  <Target Name="CleanOutputDataPublish" AfterTargets="Publish">
    <ItemGroup>
      <OutputData Include="$(OutDir)Data\**\*;$(PublishDir)Data\**\*" />
    </ItemGroup>
    <Delete Files="@(OutputData)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)Data;$(PublishDir)Data" ContinueOnError="true" />
  </Target>

</Project>
